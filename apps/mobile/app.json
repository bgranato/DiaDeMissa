{
  "expo": {
    "name": "Missa Hoje",
    "slug": "missa-hoje",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.missahoje.app",
      "infoPlist": {
        "NSUserNotificationCenterUsageDescription": "Usado para lembrar você das missas"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.missahoje.app",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
