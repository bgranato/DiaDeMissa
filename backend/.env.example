DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missa_hoje
SECRET_KEY=change-this-secret-key-in-production
GOOGLE_CLIENT_ID=your-google-client-id
DEBUG=false

# --- Gauntlet Loop (publicação de folhetos) ---
# O pipeline produtivo sempre exige mapa, montagem e conferência do PDF oficial.
# Nunca habilite fallback textual para publicar uma missa.

# Provedor LLM usado no pipeline. Padrão: anthropic (pago).
# Opções: anthropic | gemini | deepseek.
# Para custo zero no free tier do Google AI Studio: LLM_PROVIDER=gemini
LLM_PROVIDER=anthropic

# Anthropic (pago). Configure a chave se quiser manter como fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MM=claude-sonnet-5

# Google Gemini (free tier do AI Studio — multimodal, suporta PDF nativo).
# Obtenha a chave em https://aistudio.google.com/app/apikey (sem cartão).
# Free tier 2026-09: 5-15 RPM, 20-1500 RPD por modelo. Folheto Arqrio (~1 MB)
# cabe de sobra no limite inline (≤ 20 MB).
# Trade-off: Google pode treinar com inputs fora de UE/Reino Unido. O folheto é
# público (Arquidiocese do Rio), então o risco é baixo. Mantenha ANTHROPIC_API_KEY
# configurada como fallback pago em emergências.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192
GEMINI_HTTP_TIMEOUT=600

# Papéis separados (mapa, montagem, conferente). Quando vazio, herda o modelo
# principal do provider escolhido. Configure crítico em provider diferente quando
# disponível — a falha de qualquer papel bloqueia a publicação.
MODELO_MAPA=
MODELO_CONFERENTE=
CONFERENCIA_MAX_ITER=3

# --- Monitoramento de consumo/crédito de LLM (app.services.monitor_llm) ---
# Destinos dos alertas/digest (lista vírgula-separada). Vazio = admins do banco.
MONITOR_EMAILS=bruno@agenciacampana.com.br,granato1402@gmail.com
# (compat) destino único — use MONITOR_EMAILS para múltiplos.
MONITOR_EMAIL=
# Liga/desliga cada canal (1/0).
MONITOR_DIGEST=1
MONITOR_ALERTA_LIMIAR=1
MONITOR_ALERTA_EMERGENCIA=1
# Limiar de saldo baixo (US$; alerta dispara em saldo <=). Anthropic usa SALDO ESTIMADO
# (recargas registradas via scripts/registrar_recarga.py menos gasto). Fator de pico 7d.
MONITOR_LIMIAR_SALDO=2
MONITOR_PICO_FATOR=2.0
# Saldo OpenRouter (GET /api/v1/credits). Custo Anthropic via Admin API (opcional).
OPENROUTER_API_KEY=
ANTHROPIC_ADMIN_KEY=
# --- Freios de gasto (app.services.freios_gasto) ---
# Orçamento diário: acima disso, montagens automáticas pausam (missas -> pendente_revisao).
MONITOR_TETO_DIARIO=3
# Máx. de tentativas de montagem por (missa, dia).
MONITOR_MAX_TENTATIVAS_MISSA_DIA=2
# Lock de worker único do scheduler (evita 2 schedulers com --workers 2).
# Fora de /tmp: o systemd roda com PrivateTmp=true (que isolaria e esconderia o lock).
SCHEDULER_LOCK_FILE=/var/www/diademissa/backend/data/scheduler.lock
# Diretório persistente para os relatórios da auditoria, fora do código protegido.
AUDITORIA_REPORTS_DIR=/var/lib/diademissa/reports/auditoria

# --- Apoio voluntário (Mercado Pago / Checkout Pro) ---
# Nunca exponha estes valores no VITE_*, no Git ou no navegador.
# Só ative depois de cadastrar o webhook HTTPS de pagamentos no Mercado Pago.
APOIOS_ATIVOS=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
