# Variáveis de build de PRODUÇÃO (Vite inlina no bundle).
# VITE_GOOGLE_CLIENT_ID é PÚBLICO (Client ID OAuth Web do Google Identity Services)
# e precisa estar presente no build, senão o login Google não inicializa.
# VITE_API_URL omitido → usa o default relativo '/api/v1' (mesmo host, via nginx).
VITE_GOOGLE_CLIENT_ID=231612229454-6smq4hcs7vct31bsttah3vfcf1rgsaoo.apps.googleusercontent.com
